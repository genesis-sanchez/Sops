<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/contenedorInicio" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarInicio" android:layout_width="match_parent" android:layout_height="56dp" android:minHeight="?attr/actionBarSize" app:title="@string/sops_marca" app:titleTextColor="@color/white" android:background="@color/sops_principal" android:theme="@style/Sops.BarraOverlay" app:popupTheme="@style/ThemeOverlay.AppCompat.Light" android:elevation="1dp" app:titleTextAppearance="@style/Sops.Marca" app:contentInsetStart="20dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/tvBienvenida" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/inicio_bienvenida" android:textColor="@color/sops_texto" android:textSize="32sp" android:textStyle="bold" />
            <TextView style="@style/Sops.Descripcion" android:layout_marginTop="12dp" android:text="@string/inicio_descripcion" />
            <com.google.android.material.card.MaterialCardView style="@style/Sops.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/Sops.TituloSeccion" android:text="@string/inicio_mascotas_titulo" />
                    <TextView android:id="@+id/tvTotalMascotas" style="@style/Sops.Descripcion"
                        android:layout_marginTop="8dp" android:textSize="22sp" android:textStyle="bold"
                        android:accessibilityLiveRegion="polite" android:text="@string/cargando_mascotas" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Sops.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/Sops.TituloSeccion" android:text="@string/vacunas_pendientes_inicio" />
                    <TextView android:id="@+id/tvEstadoVacunasInicio" style="@style/Sops.Descripcion" android:layout_marginTop="8dp" android:text="@string/cargando_cuidados" />
                    <LinearLayout android:id="@+id/contenedorVacunasInicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Sops.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/Sops.TituloSeccion" android:text="@string/revisiones_pendientes_inicio" />
                    <TextView android:id="@+id/tvEstadoRevisionesInicio" style="@style/Sops.Descripcion" android:layout_marginTop="8dp" android:text="@string/cargando_cuidados" />
                    <LinearLayout android:id="@+id/contenedorRevisionesInicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
