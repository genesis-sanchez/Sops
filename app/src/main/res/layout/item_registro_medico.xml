<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Sops.Tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvMotivoConsulta" style="@style/Sops.TituloSeccion" />
        <TextView android:id="@+id/tvFechaConsulta" style="@style/Sops.Descripcion" android:layout_marginTop="8dp" />
        <TextView style="@style/Sops.EtiquetaDato" android:text="@string/veterinario" />
        <TextView android:id="@+id/tvVeterinarioConsulta" style="@style/Sops.Descripcion" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvObservacionesConsulta" style="@style/Sops.Descripcion" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/tvProximaRevisionConsulta" style="@style/Sops.Descripcion"
            android:layout_marginTop="12dp" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
